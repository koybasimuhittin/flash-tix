# FlashTix gateway. Rendered by envsubst at container start;
# only ${BOOKING_RATE_*} and ${GATEWAY_*} are substituted (see the Dockerfile).

# One request id per request: keep the caller's X-Request-ID, otherwise use nginx's own.
map $http_x_request_id $req_id {
    default $http_x_request_id;
    ""      $request_id;
}

# Per-user booking limit, keyed by the bearer token rather than the client IP: Locust sends
# many users from a few IPs. Requests without an Authorization header have an empty key and
# are not counted, so anonymous availability polling is never throttled.
limit_req_zone $http_authorization zone=booking_per_user:10m rate=${BOOKING_RATE_LIMIT};

server {
    listen 80;
    server_tokens off;
    client_max_body_size 1m;
    access_log ${GATEWAY_ACCESS_LOG};

    # Upstream names are resolved per request (proxy_pass with a variable) instead of once at
    # startup, so the gateway starts and serves auth/catalog even while booking-service or the
    # frontend don't exist yet; a missing service just answers 502. Docker's DNS locally,
    # kube-dns in GKE (GATEWAY_RESOLVER).
    resolver ${GATEWAY_RESOLVER} valid=10s ipv6=off;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Request-ID $req_id;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Exactly one X-Request-ID on every response, including 429/502 the gateway produces itself.
    proxy_hide_header X-Request-ID;
    add_header X-Request-ID $req_id always;
    # The id the service echoed back: proves it received the same id (empty when no upstream).
    add_header X-Upstream-Request-ID $upstream_http_x_request_id always;

    location = /gateway/healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # proxy_pass with a variable and no URI part forwards the original path unchanged
    # (/api/auth/login stays /api/auth/login). Upstreams are host:port from GATEWAY_*_UPSTREAM:
    # the microservices by default, all three pointed at the monolith in monolith mode.
    location /api/auth/ {
        set $auth_upstream http://${GATEWAY_AUTH_UPSTREAM};
        proxy_pass $auth_upstream;
    }

    location /api/events {
        set $catalog_upstream http://${GATEWAY_CATALOG_UPSTREAM};
        proxy_pass $catalog_upstream;
    }

    location /api/booking/ {
        limit_req zone=booking_per_user burst=${BOOKING_RATE_BURST} nodelay;
        limit_req_status 429;
        set $booking_upstream http://${GATEWAY_BOOKING_UPSTREAM};
        proxy_pass $booking_upstream;
    }

    location / {
        set $frontend_upstream http://${GATEWAY_FRONTEND_UPSTREAM};
        proxy_pass $frontend_upstream;
    }
}
