# Local development only. Copied to .env (gitignored) by `make up`; never put cloud secrets here.

# Postgres superuser (compose postgres container)
POSTGRES_PASSWORD=postgres-local

# Per-service database users (infra/postgres/init-databases.sh)
AUTH_DB_PASSWORD=auth-local
CATALOG_DB_PASSWORD=catalog-local
BOOKING_DB_PASSWORD=booking-local
REPORT_DB_PASSWORD=report-local

# Organizer account created by auth-service at startup (used by make seed)
BOOTSTRAP_ORGANIZER_EMAIL=organizer@flashtix.local
BOOTSTRAP_ORGANIZER_PASSWORD=organizer-local-pass
BOOTSTRAP_ORGANIZER_NAME=Demo Organizer
